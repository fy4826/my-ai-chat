      "type": "content",
      "text": " @param {boolean} immediate - 是否立即执行，默认"
    },
    {
      "type": "content",
      "text": "false\n * @returns {"
    },
    {
      "type": "content",
      "text": "Function} 防抖后的函数"
    },
    {
      "type": "content",
      "text": "\n */\nfunction debounce(fn, delay = 3"
    },
    {
      "type": "content",
      "text": "00, immediate = false) {\n  let timer"
    },
    {
      "type": "content",
      "text": " = null;\n  return"
    },
    {
      "type": "content",
      "text": " function (...args) {\n    const context = this;"
    },
    {
      "type": "content",
      "text": "\n    // 清除旧定时器\n    if (timer"
    },
    {
      "type": "content",
      "text": ") clearTimeout(timer);\n    // 立即执行"
    },
    {
      "type": "content",
      "text": "逻辑\n    if (im"
    },
    {
      "type": "content",
