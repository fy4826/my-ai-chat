    },
    {
      "type": "content",
      "text": " delay);\n  };\n}\n```\n\n#### "
    },
    {
      "type": "content",
      "text": "2. 增强版（支持取消）\n```javascript"
    },
    {
      "type": "content",
      "text": "\nfunction debounceEnhance"
    },
    {
      "type": "content",
      "text": "(fn, delay = 300, immediate = false"
    },
    {
      "type": "content",
      "text": ") {\n  let timer = null;\n  const"
    },
    {
      "type": "content",
      "text": " debounced = function (...args"
    },
    {
      "type": "content",
      "text": ") {\n    const context = this;\n    if"
    },
    {
      "type": "content",
      "text": " (timer) clearTimeout(timer);\n    if ("
    },
    {
      "type": "content",
      "text": "immediate && !timer) fn.apply(context, args);"
    },
    {
      "type": "content",
      "text": "\n    timer = setTimeout(() => {\n      if (!"
    },
    {
      "type": "content",
      "text": "immediate) fn.apply(context, args);\n      timer"
    },
    {
      "type": "content",
      "text": " = null;\n    }, delay);\n  };\n"
    },
    {
      "type": "content",
