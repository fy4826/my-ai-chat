    {
      "type": "content",
      "text": ") => {\n  searchHandler(e.target.value);\n"
    },
    {
      "type": "content",
      "text": "});\n```\n\n---\n\n"
    },
    {
      "type": "content",
      "text": "### 二、节流（Throttle）\n核心：高频触发时"
    },
    {
      "type": "content",
      "text": "，**固定时间间隔内"
    },
    {
      "type": "content",
      "text": "最多执行一次**"
    },
    {
      "type": "content",
      "text": "。\n适用：滚动监听、鼠标移动、"
    },
    {
      "type": "content",
      "text": "按钮防重复点击等。\n\n#### 1."
    },
    {
      "type": "content",
      "text": " 时间戳版（立即执行，无尾部补偿）"
    },
    {
      "type": "content",
      "text": "\n```javascript\n/**\n * 节流函数（时间"
    },
    {
      "type": "content",
      "text": "戳版）\n * @param {Function} fn -"
    },
    {
      "type": "content",
      "text": " 目标函数\n * @param {number} interval -"
    },
    {
      "type": "content",
      "text": " 执行间隔(ms)，默认300\n"
    },
    {
      "type": "content",
      "text": " * @returns {Function} 节流后的函数\n */"
    },
    {
      "type": "content",
      "text": "\nfunction throttle(fn, interval = 300)"
    },
    {
      "type": "content",
      "text": " {\n  let lastTime = 0;\n "
    },
    {
      "type": "content",
      "text": " return function (...args) {\n    const now = Date"
    },
    {
      "type": "content",
      "text": ".now();\n    const context = this;\n    //"
    },
    {
      "type": "content",
      "text": " 间隔超过设定值则"
    },
    {
      "type": "content",
      "text": "执行\n    if (now - lastTime >= interval)"
    },
    {
      "type": "content",
      "text": " {\n      fn.apply(context, args);\n      last"
    },
    {
      "type": "content",
      "text": "Time = now;\n    }\n  };\n}"
    },
    {
      "type": "content",
      "text": "\n```\n\n#### 2. 定时器版（延迟"
    },
    {
      "type": "content",
      "text": "执行，有尾部补偿）\n```javascript\nfunction throttle"
    },
    {
      "type": "content",
      "text": "Timer(fn, interval = 300) {\n"
    },
    {
      "type": "content",
      "text": "  let timer = null;\n  return function (...args"
    },
    {
      "type": "content",
      "text": ") {\n    const context = this;\n    if"
    },
    {
      "type": "content",
      "text": " (!timer) {\n     "
    },
    {
      "type": "content",
      "text": " timer = setTimeout(() => {\n        fn.apply(context, args);\n        timer = null;\n      }, interval"
    },
    {
      "type": "content",
      "text": ");\n    }\n  };\n}\n```\n\n"
    },
    {
      "type": "content",
      "text": "#### 3. 增强版（支持leading/tra"
    },
    {
      "type": "content",
      "text": "iling配置）\n```javascript\nfunction throttleEnhance(fn"
    },
    {
      "type": "content",
      "text": ", interval, options = { leading: true, trailing:"
    },
    {
      "type": "content",
      "text": " true }) {\n  let lastTime = 0;"
    },
    {
      "type": "content",
      "text": "\n  let timer = null;\n  return function (..."
    },
    {
      "type": "content",
      "text": "args) {\n    const context = this;\n   "
    },
    {
      "type": "content",
      "text": " const now = Date.now();\n    // 不立即"
    },
    {
      "type": "content",
      "text": "执行时，初始化lastTime\n    if (!lastTime"
    },
    {
      "type": "content",
      "text": " && options.leading === false) lastTime = now;"
    },
    {
      "type": "content",
      "text": "\n    const remaining = interval - (now - lastTime"
    },
    {
      "type": "content",
      "text": ");\n    // 间隔已满，执行函数\n   "
    },
    {
      "type": "content",
      "text": " if (remaining "
    },
    {
      "type": "content",
      "text": "<= 0) {\n      if ("
    },
    {
      "type": "content",
      "text": "timer) {\n        clearTimeout(timer);\n       "
    },
    {
      "type": "content",
      "text": " timer = null;\n      }\n      fn.apply(context"
    },
    {
      "type": "content",
      "text": ", args);\n      lastTime = now;\n   "
    },
    {
      "type": "content",
      "text": " } \n    // 允许尾部执行，且无定时器"
    },
    {
      "type": "content",
      "text": "时，创建定时器\n    else if (!timer && options"
    },
    {
      "type": "content",
      "text": ".trailing !== false) {\n      timer = setTimeout"
    },
    {
      "type": "content",
      "text": "(() => {\n        fn.apply(context, args);\n        lastTime = options."
    },
    {
      "type": "content",
      "text": "leading === false ? 0 : Date.now();\n       "
    },
    {
      "type": "content",
      "text": " timer = null;\n      }, remaining);\n    }"
    },
    {
      "type": "content",
      "text": "\n  }\n  }\n}\n```\n#### 4.节流使用示例\n```javascript\n// 滚动节流：每1000ms执行一次\nconst scrollHandler = throttle(() => {\n  console.log('滚动位置:', window.scrollY);\n}, 1000);\nwindow.addEventListener('scroll', scrollHandler);\n\n// 按钮点击节流：2s内仅执行一次\nconst clickHandler = throttle(() => {\n  console.log('按钮点击');\n}, 2000);\ndocument.getElementById('submitBtn').addEventListener('click', clickHandler);\n```\n\n---\n\n"
    },
    {
      "type": "content",
      "text": "### 三、核心区别对比\n| 特性 |"
